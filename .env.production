# ===================================
# .env.production - 生产环境配置模板
# ===================================
# 此文件包含非敏感信息，可以提交到 Git
# 敏感信息（如密钥、密码等）由 Jenkins 凭据管理系统注入

# 应用基础配置
APP_PORT=3210
DATABASE_DRIVER=node
NEXT_PUBLIC_SERVICE_MODE=server
CDN_USE_GLOBAL=1

# NextAuth 配置
NEXT_PUBLIC_ENABLE_NEXT_AUTH=1
ENABLE_AUTH_PROTECTION=1
NEXT_PUBLIC_ENABLE_CLERK_AUTH=0
NEXT_AUTH_SSO_PROVIDERS=credentials

# S3 配置（非敏感部分）
S3_BUCKET=xuge
S3_ENDPOINT=https://838de6c927cbb6dc5aa8476ec542f803.r2.cloudflarestorage.com
S3_PUBLIC_DOMAIN=https://oss.6357648.xyz

# ===================================
# 以下敏感信息需要在 Jenkins 中配置
# ===================================
# APP_URL - 在 Jenkins 中动态设置
# DATABASE_URL - 数据库连接字符串
# KEY_VAULTS_SECRET - 密钥加密密钥
# NEXT_AUTH_SECRET - NextAuth 密钥
# NEXTAUTH_URL - NextAuth 回调地址
# S3_ACCESS_KEY_ID - S3 访问密钥
# S3_SECRET_ACCESS_KEY - S3 密钥
