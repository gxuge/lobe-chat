# Qiankun Environment Variables
# Copy to .env.local and modify as needed

# ============================================
# Qiankun Configuration
# ============================================

# Enable/disable qiankun micro-frontend mode
# Set to 'true' when running as a sub-app in main application
QIANKUN_MODE=false

# Main application origin (for CORS)
# Only used when QIANKUN_MODE=true
# Production: Set this to your actual main app domain
MAIN_APP_ORIGIN=http://localhost:3100

# ============================================
# Server Configuration (REQUIRED for external auth)
# ============================================

# Enable server-side database (required for external authentication)
NEXT_PUBLIC_ENABLED_SERVER_SERVICE=1

# Database connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/lobechat

# ============================================
# Authentication Configuration
# ============================================

# Main app API endpoint for token verification (optional, implement in code)
# MAIN_APP_VERIFY_TOKEN_URL=https://your-main-app.com/api/verify-token

# ============================================
# Other LobeChat Configuration
# ============================================

# Add your other LobeChat environment variables here
# NODE_ENV=development
# NEXT_PUBLIC_CLIENT_DB=pglite
# etc.
